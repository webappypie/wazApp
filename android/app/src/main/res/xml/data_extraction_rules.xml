<?xml version="1.0" encoding="utf-8"?>
<!-- WazApp is local-first: nothing in the app's private storage (library, Private Folder, database) is copied
     to cloud backup or to a new phone by the system. Users keep their files by exporting them (Save to gallery). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
