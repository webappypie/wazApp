# android/key.properties.example
#
# Template for production release signing.
# Copy this file to "android/key.properties" and provide real credentials.
# NOTE: "android/key.properties" is git-ignored and must never be committed.
#
# To create a new keystore, execute:
# keytool -genkey -v -keystore release-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias wapptidy_key

keyAlias=wapptidy_key
keyPassword=YOUR_KEY_PASSWORD
storeFile=../release-keystore.jks
storePassword=YOUR_STORE_PASSWORD
