# android/key.properties.example
#
# Template for release signing. Copy to "android/key.properties" and fill in real values.
# "android/key.properties" is git-ignored and must never be committed.
#
# To create an upload keystore (keep it and its passwords safe, outside the repo):
# keytool -genkey -v -keystore wazapp-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias wazapp_upload

keyAlias=wazapp_upload
keyPassword=YOUR_KEY_PASSWORD
storeFile=../wazapp-upload.jks
storePassword=YOUR_STORE_PASSWORD
